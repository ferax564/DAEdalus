{
  "name": "daedalus-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "wasm": "cargo build -p daedalus-wasm --profile release-wasm --target wasm32-unknown-unknown --manifest-path ../Cargo.toml && wasm-bindgen --target web --out-dir src/wasm ${CARGO_TARGET_DIR:-../target}/wasm32-unknown-unknown/release-wasm/daedalus_wasm.wasm && npm run wasm-opt",
    "msl": "node scripts/fetch-msl.mjs",
    "conformance": "node scripts/copy-conformance.mjs",
    "dev": "node scripts/copy-conformance.mjs && vite",
    "build": "node scripts/copy-conformance.mjs && tsc --noEmit && vite build && node scripts/build-docs.mjs",
    "docs": "node scripts/build-docs.mjs",
    "preview": "vite preview",
    "test": "tsc --noEmit",
    "wasm-opt": "wasm-opt -O3 --enable-simd --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-multivalue --enable-reference-types src/wasm/daedalus_wasm_bg.wasm -o src/wasm/daedalus_wasm_bg.wasm"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "binaryen": "123.0.0",
    "marked": "15.0.12",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@codemirror/commands": "6.7.1",
    "@codemirror/language": "6.10.3",
    "@codemirror/legacy-modes": "6.4.2",
    "@codemirror/search": "6.5.7",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.34.1",
    "@lezer/highlight": "1.2.5",
    "three": "0.169.0"
  }
}
